id     = "launcher-typing-centred"
about  = """A centred launcher, 216 px wide, whose card is as tall as its
results (`height: 35 + 30 * hits.len`, so its height springs) filters
them while the query is typed a letter at a time, faster than its motion
settles, then erased: rows that stay glide, rows that leave fade out,
rows that come back fade in, in a list the card clips where its springing
height has not reached yet. The compositor centres the panel in the
screen and centres it again at every new size (eval-false-alarms: the
sandbox places a layer surface as `placement::layer_config` and
`arranged_area` do); render holds the panel at its larger size while the
card shrinks and places the card where the smaller box will be, and
glides a grown one from where it was, so nothing drawn jumps on screen.
The prompt at the card's top is centred in it and moves only by the
card's centring."""
screen = { width = 360, height = 640, scale = 1.0 }
hz     = 60

=== shell.strand
state query = ""
let apps = ["calculator", "calendar", "camera", "chess", "clock", "contacts", "cheese"]
let hits = apps.filter(a => a.starts_with(query))

panel Launcher {
  anchor: center; open: true
  col { id: card; width: 216; height: 35 + 30 * hits.len; clip: true; pad: 9; gap: 5; radius: 12; bg: #1b1d2b; align: center
    text query == "" ? "type to search" : query { id: prompt; color: #c8cbe0 }
    list { id: results; gap: 3
      for a in hits key a {
        row { pad: 0, 7; height: 27; radius: 6; align: center; bg: #2b2f45
          enter { opacity: 0 }
          exit { opacity: 0 }
          text a { color: #eceef8 }
        }
      }
    }
  }
}

=== steps
rest
mark c
set query c
rest
mark ca-cal-calc
set query ca
wait 50
set query cal
wait 50
set query calc
rest
mark erase
set query cal
wait 40
set query ca
wait 40
set query c
rest
mark clear
set query ""
rest
