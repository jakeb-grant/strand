// expect: check::type_mismatch
// Shader uniforms take the values WGSL uniforms can: numbers, lengths,
// angles, durations, colours and comma vectors of them; a vector is a
// WGSL vec2 to vec4.
component Glow {
  shader "aurora.wgsl" { u_speed: 0.4; u_dir: 1, 0; u_tint: $accent; u_name: "aurora"; u_on: true; u_v: 1, 2, 3, 4, 5; u_x: [1, 2] }
}
