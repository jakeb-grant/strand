---
source: crates/strand-compiler/tests/instantiate.rs
expression: shell.scene.render()
---
bar height=36 margin=[$space.2, $space.2, 0] edge=top screens="Mock | DP-1 | Display" name="Top" bg=$surface.alpha(0.72) color=$fg radius=$radius.lg shadow=$elevation.md blur=24 font=$font.ui
  split pad=[0, $space.3]
    start gap=$space.3
      row gap=$space.1
        box width=24 size=8 bg=$accent radius=full hit=grow(6) enter={width: 0; opacity: 0} exit={width: 0; opacity: 0}
        box size=8 bg=$fg.muted radius=full hit=grow(6) enter={width: 0; opacity: 0} exit={width: 0; opacity: 0}
      text max_width=40% color=$fg.muted text="strand — design.md" ellipsis=end
    center
      text text="Mon 05  09:41"
        popup open=true
