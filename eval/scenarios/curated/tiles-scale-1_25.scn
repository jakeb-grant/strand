id     = "tiles-scale-1_25"
about  = """Boxes that touch in layout touch on screen at a fractional scale
(docs/decisions.md wave3-pixels: a box's edges depend only on where they
fall, so two boxes sharing an edge share its physical pixel): at scale 1.25
a segmented control of three tiles that `grow` into a 100 px row (33, 34
and 33 px, flush, no gap) sits on its own background, followed by a row of
four flush boxes 15, 14, 14 and 14 px wide. Most of these edges fall a
quarter, a half or three quarters of the way into a physical pixel. A state
change widens the control to 130 px and back, so every edge after it moves
to a new fraction. At rest no seam opens between two tiles and no pixel is
drawn twice."""
screen = { width = 320, scale = 1.25 }

=== shell.strand
state wide = false
bar Top {
  height: 30
  bg: #101317
  row { id: strip; height: 24; gap: 0; align: center; pad: 0, 10
    row { id: seg; width: wide ? 130 : 100; height: 18; gap: 0; bg: #2c313a
      box { id: a; grow: 1; height: 18; bg: #e06c75 }
      box { id: b; grow: 1; height: 18; bg: #98c379 }
      box { id: c; grow: 1; height: 18; bg: #61afef }
    }
    box { id: t1; width: 15; height: 12; bg: #5c6370 }
    box { id: t2; width: 14; height: 12; bg: #e5c07b }
    box { id: t3; width: 14; height: 12; bg: #c678dd }
    box { id: t4; width: 14; height: 12; bg: #56b6c2 }
  }
}

=== steps
rest
mark widen
set wide true
intend #seg changes
intend #a changes
intend #b changes
intend #c changes
intend #t1 moves
intend #t2 moves
intend #t3 moves
intend #t4 moves
rest
mark narrow
set wide false
intend #seg changes
intend #a changes
intend #b changes
intend #c changes
intend #t1 moves
intend #t2 moves
intend #t3 moves
intend #t4 moves
rest
