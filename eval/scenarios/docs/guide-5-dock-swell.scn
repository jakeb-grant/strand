id     = "docs-guide-5-dock-swell"
about  = """Guide level 5's dock whose icons swell toward the pointer
(docs/guide/level-5.md, "Icons that swell toward the pointer"), word for
word. Six apps are pinned (the pins seeded as the list a reader would
have built, the apps set on the mock with icons Adwaita has); the pointer
runs along the dock and back off it, and each icon grows by how near the
pointer is, the one under it 1.4 times its size. The icons' scale follows
the pointer by the config's own expression, so the run says it is
intended. The seeded pins settle in the warmup, before the recording
starts."""
screen = { width = 420, height = 140, scale = 1.5 }
warmup = 400

[services]
"system.accent" = "#a13c1c"
"apps.all" = '[{"id": "firefox", "name": "Firefox", "comment": null, "icon": "text-html", "categories": [], "actions": []}, {"id": "org.gnome.Nautilus", "name": "Files", "comment": null, "icon": "folder", "categories": [], "actions": []}, {"id": "music", "name": "Music", "comment": null, "icon": "audio-x-generic", "categories": [], "actions": []}, {"id": "photos", "name": "Photos", "comment": null, "icon": "image-x-generic", "categories": [], "actions": []}, {"id": "videos", "name": "Videos", "comment": null, "icon": "video-x-generic", "categories": [], "actions": []}, {"id": "editor", "name": "Text Editor", "comment": null, "icon": "text-x-generic", "categories": [], "actions": []}]'

[seed]
"dock.pins" = '[{"app": "firefox", "label": "Firefox"}, {"app": "org.gnome.Nautilus", "label": "Files"}, {"app": "music", "label": "Music"}, {"app": "photos", "label": "Photos"}, {"app": "videos", "label": "Videos"}, {"app": "editor", "label": "Text Editor"}]'

=== dock.strand
// dock.strand: a dock on every monitor whose icons swell toward the pointer
type Pin { app: AppId; label: text }
state pins: [Pin] key app = [
  Pin(app: "firefox", label: "Firefox"),
  Pin(app: "org.gnome.Nautilus", label: "Files"),
] persist

keyframes hop { 0%, 100% { y: 0 }; 40% { y: -10 }; duration: 450ms }

bar Dock {
  edge: bottom; height: 64; margin: 0, $space.2, $space.2
  bg: $surface.alpha(0.72); blur: 24; radius: $radius.xl; shadow: $elevation.md
  row { id: icons; grow: 1; justify: center; align: center; gap: $space.2
    on drop(p: Pin, at: int) { pins.move(p.app, at) }
    for p in pins key p.app {
      let app = apps.all.find(a => a.id == p.app)
      image app?.icon ?? "application-x-executable" { size: 44; drag: p; tooltip: p.label
        cursor: pointer
        // How far the pointer is from this icon's centre, along the row.
        let off = (icons.pointer?.x ?? -1000) - (self.box.x - icons.box.x + 22)
        scale: 1 + 0.4 * (1 - off.abs() / 120).max(0)
        enter { scale: 0; opacity: 0 }
        when app == null { opacity: 0.4 }
        on click     { app?.launch(); play hop }
        on secondary { pins.remove_key(p.app) }
      }
    }
  }
}

=== steps
rest
wait 600
mark along
intend bar>row>image changes
glide 60,36 -> 360,36 over 600 on bar
mark off
intend bar>row>image changes
leave
rest
