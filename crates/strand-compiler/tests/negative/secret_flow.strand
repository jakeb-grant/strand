// expect: check::secret_flow
// A password typed into a `type: password` input warns where it is shown,
// kept or sent; its length and whether it is empty do not.
permit exec "say"
action say(t: text) ["say", t]
export state locked = false
lock {
  open: <-> locked
  state secret = ""
  let hint = "you typed " + secret
  when secret != "" { bg: $accent }
  input { type: password; text: <-> secret; focus: true
    on activate { if secret != "" { auth.submit(secret) }; say(secret); secret = "" }
  }
  text num(secret.len)
  text hint
}
