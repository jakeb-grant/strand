// expect: check::dict_key
// A dictionary key is compared exactly, so a fraction or a number with a
// unit cannot key one (`2px` and `2ch` would be two keys, NaN none): the
// help says to key by a whole number or by text. An untyped literal's
// keys are checked the same way.
state widths: [float: text] = []
state gaps: [length: int] = []
let lookup = [0.5: "half", 1.5: "more"]
