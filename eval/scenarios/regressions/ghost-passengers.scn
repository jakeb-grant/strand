id     = "ghost-passengers"
about  = """A removed row's own `exit` carries what is in it (docs/decisions.md evalfix,
owner-2026-10-21, replay-owner): a list drops its middle entry, which plays
its `exit` to `opacity: 0; width: 70` on a linear 200 ms fade while it clips
what it holds (spec.md 6.4: "a removed subtree plays its `exit` pose";
design.md "Poses"). Its badge and the clipped strip holding its label ride
along: their own `exit` poses are not the removed subtree's, and they stay
mounted until the entry unmounts. As the entry narrows, its clip cuts the
strip out, and the renderer then visits nothing in it, so the label's rows
end there at its own full opacity; once the entry has faded to 0 the
renderer draws none of its children, so the badge's rows end a frame before
the entry's. Each read as unmounting short of its own pose. Pop-out judges
the removed entry, and holds each passenger to staying drawn while the
entry still shows something of it. Written for Strand's own gate, apart
from any shell's values."""
screen = { width = 280, height = 200, scale = 1.0 }
hz     = 60

=== shell.strand
state drop = false
let items = drop ? ["mail", "call"] : ["mail", "chat", "call"]

panel List {
  anchor: top_left; open: true
  col { width: 240; pad: 8; gap: 6; bg: #1b1d2b
    for it in items key it {
      row { id: entry; clip: true; height: 36; width: 224; gap: 6; pad: 0, 6; align: center; bg: #33384d
            opacity: 1 ~ ease(linear, 200ms)
            exit { opacity: 0; width: 70 }
        box { id: badge; width: 20; height: 20; shrink: 0; bg: #f5a97f; exit { scale: 0 } }
        stack { id: strip; clip: true; width: 150; height: 24; shrink: 0; margin: 0, 0, 0, 60
          box { id: label; width: 120; height: 12; bg: #cad3f5; exit { opacity: 0; x: 30 } }
        }
      }
    }
  }
}

=== steps
rest
mark drop
set drop true
rest
