id     = "docs-dbus"
about  = """The D-Bus and actions how-to (site/how-to/dbus-and-actions.md): its
two files, word for word. The sandbox has no bus or programs, so the power
profile is given (`balanced`) and `calc` is answered as qalc would answer it:
"2 + 2" is typed and its result shows beside it as it goes; a click on Record starts
`rec`, which counts as running, so the button reads Stop."""
screen = { width = 640, height = 100, scale = 2.0 }

[services]
"system.accent" = "#a13c1c"
"ppd.profile" = "balanced"

=== services.strand
// services.strand: what no built-in service does
permit exec "hyprctl", "qalc", "wf-recorder"

service ppd from dbus system "net.hadess.PowerProfiles" {
  profile: text rw = ActiveProfile
  action hold(profile: text, reason: text, app: text) = HoldProfile
}

action dispatch(ws: int) ["hyprctl", "dispatch", "workspace", ws]
action calc(q: text) -> text ["qalc", "-t", q]
action rec(file: path) ["wf-recorder", "-f", file]

=== bar.strand
state query = ""

bar Top {
  edge: top; height: 32
  bg: $surface; font: $font.ui; color: $fg
  split { pad: 0, $space.3
    start { gap: $space.2
      button "1" { on click { dispatch(1) } }
      button "2" { on click { dispatch(2) } }
    }
    center { gap: $space.2
      input { width: 160; text: <-> query; placeholder: "2 + 2" }
      text calc(query) ?? "" { color: $fg.muted }
    }
    end { gap: $space.2
      button ppd.profile { on click { ppd.hold("performance", "a long build", "strand") } }
      button rec.running ? "Stop" : "Record" {
        on click { if rec.running { rec.stop() } else { rec("/tmp/clip.mp4") } }
      }
    }
  }
}

=== steps
rest
mark calc
answer action calc "2"
set bar.query 2
wait 150
answer action calc "2"
set bar.query 2 +
wait 150
answer action calc "4"
set bar.query 2 + 2
wait 300
mark record
click 600,16 on bar
wait 300
