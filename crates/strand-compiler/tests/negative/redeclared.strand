// expect: check::redeclared
// Surfaces, services and other global names are shared by every file of a
// config: declaring one twice is an error naming both places. (M6) A
// component, type, enum or `fn` may share its name with one in another
// file (spec.md 4.2), but never with a surface, nor within one file.
// file: bar.strand
bar Dot { box { size: 8 } }
enum Kind { a, b }
// file: widgets.strand
component Dot { box { size: 6 } }
state x = 1
state x = 2
// A handler `let` twice in one block, and a prop set twice in one element.
component Twice {
  slider { value: 0.5; value: 0.3
    on click { let x = 4; let y = x; let x = 5 }
  }
}
// The positional is the prop it fills; a prop set twice in a `when`.
component Both {
  meter 0.5 { value: 0.7 }
  box { when hover { bg: $accent; bg: $error } }
}
