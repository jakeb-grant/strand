# The browser of scripts/eval/viewer-check.sh (docs/decisions.md
# eval-viewer-browser): Microsoft's Playwright image, pinned by version
# and digest, which carries Chromium for Playwright 1.62.0 but not the
# Python package; that is installed here at the same exact version. The
# check itself runs with no network.
FROM mcr.microsoft.com/playwright/python:v1.62.0-noble@sha256:aa81288e738725378becba5b3e06cb0f3a7f012a610e87e8d767a090ea3f740d
RUN pip install --no-cache-dir --break-system-packages playwright==1.62.0 \
 && python3 -I -c "import playwright.sync_api"
