/// The app that sent a notification.
record NotificationApp {
  /// The app's name.
  name: text
  /// The app's icon: an icon name or a path.
  icon: text
}

/// A button a notification offers.
record NotificationAction key id {
  /// Its identity: the key the sender gave it.
  id: text
  /// Its label: `button a.label`.
  label: text
  /// The notification it belongs to.
  notification: int
  /// Invokes it: `on click { a.invoke() }`. The sender is told; the
  /// notification closes unless it is resident.
  action invoke()
}

/// A desktop notification, keyed by `id`.
record Notification key id {
  /// Its identity.
  id: int
  /// The app that sent it.
  app: NotificationApp
  /// Its summary line.
  summary: text
  /// Its body, which may hold basic markup (`markup: basic`).
  body: text
  /// An image it carries, if any: a path.
  image: text?
  /// `low`, `normal` or `critical`.
  urgency: Urgency
  /// How long the sender asked it to show; null leaves it to the shell:
  /// `after n.timeout ?? 6s { n.expire() }`.
  timeout: duration?
  /// The sender asked it never to expire (an `expire_timeout` of 0): a
  /// shell keeps its popup with `after n.timeout ?? 6s while !n.persistent
  /// { n.expire() }`.
  persistent: bool
  /// When it arrived.
  time: Date
  /// The buttons it offers; none on one remembered from an earlier run
  /// (`notifications.remember`), whose sender cannot hear them.
  actions: [NotificationAction]
  /// How far along what it reports is, 0 to 1 (the sender's `value`
  /// hint, a percentage), null when it says none: `meter n.progress ?? 0`.
  progress: float?
  /// The kind of event it reports (the `category` hint: `email.arrived`,
  /// `transfer.complete`), null when the sender gives none.
  category: text?
  /// The desktop entry of the app that sent it (the `desktop-entry`
  /// hint), null when the sender gives none.
  desktop_entry: text?
  /// The sender takes a typed reply (an `inline-reply` action, which is
  /// not among `actions`): `if n.can_reply { input … }`. Strand offers
  /// senders inline replies only while the config names `can_reply` or
  /// `reply`, so a sender keeps its own Reply button otherwise. False on
  /// one remembered from an earlier run.
  can_reply: bool
  /// The sender gave it a default action, so `activate()` reaches the
  /// sender: without one a click on it can only close it, and on a resident
  /// one does nothing at all. False on one remembered from an earlier run.
  can_activate: bool
  /// Ends its popup, as a timeout does; it stays in `all`, still open
  /// (its actions still reach the sender) until dismissed.
  action expire()
  /// Closes it: `on secondary { n.dismiss() }`.
  action dismiss()
  /// Invokes its default action, if it has one (`can_activate`), then
  /// closes it unless it is resident: `on click { if n.can_activate {
  /// n.activate() } }`. On one without a default action it only closes it;
  /// on a resident one without a default action it does nothing at all.
  action activate()
  /// `n.reply(text)` sends `text` to the sender as its inline reply (to
  /// that sender alone, never to other programs on the bus) and closes
  /// it (unless it is resident); nothing when it takes no reply.
  action reply(text: text)
}

/// The notification server: the shell owns the freedesktop notification
/// name, and says so clearly if another daemon (dunst, mako) has it.
service notifications {
  /// The notifications to show now; each leaves when it expires or is
  /// dismissed.
  popups: [Notification]
  /// Every notification kept, popups included, oldest first
  /// (`notifications.all.reverse()` for newest first): the newest 1,000
  /// (older ones close as expired), remembered across restarts while
  /// `remember` is on.
  all: [Notification]
  /// How many notifications are kept.
  count: int
  /// Do not disturb: new notifications that are not critical skip the
  /// popups (they are kept in `all`, and `received` still fires).
  /// Writable.
  dnd: bool rw
  /// Notifications kept in `all` are remembered across restarts (under
  /// `$XDG_STATE_HOME/strand`, readable only by you); on by default.
  /// Those from an earlier run come back in `all` (never as popups, and
  /// without `received`) with no buttons, and `activate()` only dismisses
  /// them, since their senders cannot hear it. A sender's `transient`
  /// notifications are never remembered. Writable: false forgets every
  /// remembered notification at once, and stays false across restarts.
  remember: bool rw
  /// Dismisses every notification.
  action clear()
  /// A notification arrived. Events are lossless queues:
  /// `on notifications.received(n) { … }`.
  event received(n: Notification)
}
