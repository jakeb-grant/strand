/// A toplevel window, from `ext-foreign-toplevel-list`, with what the
/// compositor's IPC adds.
record Window key id {
  /// Its identity: the compositor's id when its IPC is used, else the
  /// protocol's identifier.
  id: text
  /// Its title: `windows.focused?.title`.
  title: text
  /// The app's id, such as `firefox`.
  app_id: text
  /// An icon name for its app: its desktop entry's icon, else its app
  /// id (lowercased when only that is in the icon theme).
  icon: text
  /// The workspace it is on, when known.
  workspace: int?
  /// It has focus.
  focused: bool
  /// It is minimised.
  minimized: bool
  /// It is maximised.
  maximized: bool
  /// It is fullscreen.
  fullscreen: bool
  /// It asks for attention.
  urgent: bool
  /// The installed app it belongs to, found from its app id (the desktop
  /// entry's id, `StartupWMClass`, a reverse-DNS id's last part, its
  /// name): `win.app?.categories`. Null when no entry matches.
  app: App?
  /// Its place and size on its screen, logical pixels from the screen's
  /// top-left corner, from the compositor's IPC: a tiled niri window
  /// (which scrolls with its column) and the standard protocols have
  /// none. Hyprland tells no move of a floating window, so there it is
  /// as of the window's last other change.
  rect: Rect?
  /// Raises and focuses it.
  action focus()
  /// Asks it to close.
  action close()
  /// Minimises it.
  action minimize()
  /// `win.maximize()` maximises it, or restores it when it is maximised.
  action maximize()
  /// `win.fullscreen()` makes it fullscreen, or restores it when it is
  /// fullscreen.
  action fullscreen()
  /// `win.move_to(ws)` moves it to workspace `ws`, the focus staying
  /// where it is (on the compositors' IPC: Hyprland, sway, niri).
  action move_to(ws: Workspace)
}

/// Toplevel windows, from `ext-foreign-toplevel-list`.
service windows {
  /// The focused window, if any: `windows.focused?.title`.
  focused: Window?
  /// Every window, keyed by `id`.
  all: [Window]
}
