id     = "reveal-enter"
about  = """A finding of evalfix (docs/decisions.md evalfix): a row that mounts with a
growing card plays its enter pose from its first frame, wholly cut out by the
card's clip, and comes into view only as the card's height spring uncovers it,
by then most of the way to rest. Its pose played; the moving clip edge is
what reveals it. `vanish`'s pop-in judged the first frame it showed, a
frame the clip chose, and called it a pop-in. A node kept from view by its
ancestors' clip from the frame it mounts until it shows is judged where its
enter starts. Its title, mounted in view, is judged where it first shows."""
screen = { width = 400, height = 320, scale = 1.0 }
hz     = 60

=== shell.strand
state open = false

panel Card {
  anchor: top; open: true
  col { id: card; clip: true; bg: #303446; width: 300; align: start
        height: 40 ~ spring(450, 0.8)
        when open { height: 260 ~ spring(450, 0.8) }
    col { width: 300; height: 260; shrink: 0; pad: 10; gap: 10
      if open {
        row { id: title; height: 20; width: 200; shrink: 0; bg: #c6d0f5; enter { opacity: 0; y: -8 } }
      }
      box { height: 150; shrink: 0 }
      if open {
        row { id: late; height: 30; width: 260; shrink: 0; bg: #8caaee; enter { opacity: 0; y: -8 } }
      }
    }
  }
}

=== steps
rest
mark grow
set open true
rest
