# Generated by scripts/site/media.sh from ../layout.scn: the same scenario with the
# system in dark mode, for the site's dark pictures. Do not edit.
id     = "docs-layout-dark"
about  = """The layout page's bar (site/concepts/layout.md), word for word: a
split with workspace dots at the start, the clock truly centred and two
readings at the end. The focused workspace moves from 1 to 3 to 2; its dot
widens into a pill and the others glide aside, while the clock stays put."""
screen = { width = 360, height = 100, scale = 2.0 }

[services]
"system.dark" = true
"system.accent" = "#a13c1c"
"battery.percent" = 0.82
"audio.sink.volume" = 0.45
"workspaces.all" = "[{\"id\": 1, \"name\": \"1\", \"focused\": true, \"active\": true, \"occupied\": true, \"urgent\": false, \"screen\": \"DP-1\", \"windows\": []}, {\"id\": 2, \"name\": \"2\", \"focused\": false, \"active\": false, \"occupied\": true, \"urgent\": false, \"screen\": \"DP-1\", \"windows\": []}, {\"id\": 3, \"name\": \"3\", \"focused\": false, \"active\": false, \"occupied\": true, \"urgent\": false, \"screen\": \"DP-1\", \"windows\": []}, {\"id\": 4, \"name\": \"4\", \"focused\": false, \"active\": false, \"occupied\": true, \"urgent\": false, \"screen\": \"DP-1\", \"windows\": []}]"

=== bar.strand
bar Top {
  edge: top; height: 36
  bg: $surface; font: $font.ui; color: $fg
  split { pad: 0, $space.3
    start { gap: $space.2
      for ws in workspaces.all {
        box { size: 8; radius: full; bg: $fg.faint
          when ws.focused { width: 20; bg: $accent }
        }
      }
    }
    center { text clock.format("%H:%M") }
    end { gap: $space.2
      text pct(battery.percent)
      text pct(audio.sink.volume) { width: 4ch; align: end }
    }
  }
}

=== steps
rest
mark focus-3
set workspaces.all [{"id": 1, "name": "1", "focused": false, "active": false, "occupied": true, "urgent": false, "screen": "DP-1", "windows": []}, {"id": 2, "name": "2", "focused": false, "active": false, "occupied": true, "urgent": false, "screen": "DP-1", "windows": []}, {"id": 3, "name": "3", "focused": true, "active": true, "occupied": true, "urgent": false, "screen": "DP-1", "windows": []}, {"id": 4, "name": "4", "focused": false, "active": false, "occupied": true, "urgent": false, "screen": "DP-1", "windows": []}]
wait 600
mark focus-2
set workspaces.all [{"id": 1, "name": "1", "focused": false, "active": false, "occupied": true, "urgent": false, "screen": "DP-1", "windows": []}, {"id": 2, "name": "2", "focused": true, "active": true, "occupied": true, "urgent": false, "screen": "DP-1", "windows": []}, {"id": 3, "name": "3", "focused": false, "active": false, "occupied": true, "urgent": false, "screen": "DP-1", "windows": []}, {"id": 4, "name": "4", "focused": false, "active": false, "occupied": true, "urgent": false, "screen": "DP-1", "windows": []}]
wait 600
