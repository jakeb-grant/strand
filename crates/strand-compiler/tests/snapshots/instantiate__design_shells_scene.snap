---
source: crates/strand-compiler/tests/instantiate.rs
expression: shell.scene.render()
---
bar height=36 margin=[$space.2, $space.2, 0] edge=top screens="Mock | DP-1 | Display" name="Top" bg=$surface.alpha(0.72) color=$fg radius=$radius.lg shadow=$elevation.md blur=24 font=$font.ui
  split pad=[0, $space.3]
    start gap=$space.3
      row gap=$space.1
        box width=24 size=8 bg=$accent radius=full hit=grow(6) enter={width: 0; opacity: 0} exit={width: 0; opacity: 0}
        box size=8 bg=$fg.muted radius=full hit=grow(6) enter={width: 0; opacity: 0} exit={width: 0; opacity: 0}
      text max_width=40% color=$fg.muted text="strand — design.md" ellipsis=end
    center
      text text="Mon 05  09:41"
        popup open=false
    end gap=$space.3
      row gap=$space.1
        icon source="audio-volume-medium-symbolic"
      row gap=$space.1
        icon source="battery-good-symbolic"
        text text="42% · 2 h 5 min"
      image size=16 source="network-wireless"
bar height=36 margin=[$space.2, $space.2, 0] edge=top screens="Mock | HDMI-A-1 | Display" name="Top" bg=$surface.alpha(0.72) color=$fg radius=$radius.lg shadow=$elevation.md blur=24 font=$font.ui
  split pad=[0, $space.3]
    start gap=$space.3
      row gap=$space.1
        box size=8 bg=$fg.muted radius=full hit=grow(6) enter={width: 0; opacity: 0} exit={width: 0; opacity: 0}
      text max_width=40% color=$fg.muted text="strand — design.md" ellipsis=end
    center
      text text="Mon 05  09:41"
        popup open=false
    end gap=$space.3
      row gap=$space.1
        icon source="audio-volume-medium-symbolic"
      row gap=$space.1
        icon source="battery-good-symbolic"
        text text="42% · 2 h 5 min"
      image size=16 source="network-wireless"
panel anchor=center layer=overlay keyboard=exclusive screens=focused open=false name="Launcher" enter={opacity: 0; scale: 0.96} exit={opacity: 0; scale: 0.96}
panel margin=$space.3 anchor=top_right layer=overlay keyboard=none screens=focused open=true name="Toasts"
  col width=380 gap=$space.2
    col pad=$space.3 gap=$space.2 bg=$surface.alpha(0.88) radius=$radius.lg border=template(1, #000000 <- $border) shadow=$elevation.lg blur=24 enter={x: 420; opacity: 0} exit={x: 420; opacity: 0; height: 0}
      row gap=$space.2
        image size=36 radius=$radius.sm source=""
        col grow=1
          text text="Mail · New message" weight=600 ellipsis=end
          text color=$fg.muted text="…" max_lines=4 markup=basic
        icon size=14 source="window-close-symbolic"
    col pad=$space.3 gap=$space.2 bg=$surface.alpha(0.88) radius=$radius.lg border=template(1, #000000 <- $error) shadow=$elevation.lg blur=24 enter={x: 420; opacity: 0} exit={x: 420; opacity: 0; height: 0}
      row gap=$space.2
        image size=36 radius=$radius.sm source=""
        col grow=1
          text text="Battery · Battery low" weight=600 ellipsis=end
          text color=$fg.muted text="…" max_lines=4 markup=basic
        icon size=14 source="window-close-symbolic"
osd margin=[0, 0, 96] anchor=bottom open=false name="Level" enter={opacity: 0; scale: 0.9} exit={opacity: 0; scale: 0.9}
