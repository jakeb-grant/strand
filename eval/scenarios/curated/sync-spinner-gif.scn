id     = "sync-spinner-gif"
about  = """An animated GIF spinner in a bar chip while a sync runs
(eval-coverage-5; design.md "Generative, data-driven and media": `image
"spin.gif"`, frames streamed; "Runtime changes these need" 4: a GIF's clock
runs at its own rate, so the bar repaints at the GIF's frame changes, every
100 ms, not at every refresh). The chip slides in with the spinner turning;
the desktop's reduced motion holds the GIF on a frame (7: it turns off loops)
and the bar rests where the reduced twin does; the sync ending lets the chip
go. eval/fixtures/images/spinner.gif is four 16 x 16 frames of a quarter ring
going round, looping forever."""
screen = { width = 300, height = 120, scale = 1.0 }
hz     = 60

=== shell.strand
state syncing = false
bar Top {
  height: 30; bg: #1e1e2e
  row { height: 30; pad: 0, 10; gap: 6; align: center
    spacer {}
    if syncing {
      row { id: chip; height: 22; pad: 0, 8; gap: 6; align: center; radius: 11; bg: #313244
        enter { opacity: 0; x: 6 }
        image "../../fixtures/images/spinner.gif" { id: spin; width: 16; height: 16 }
        text "Syncing" { color: #cdd6f4 }
      }
    }
    text "12:30" { id: clock; color: #cdd6f4 }
  }
}

=== steps
rest
mark start
intend #chip enters
set syncing true
wait 700
mark reduce
reduce-motion on
rest
mark done
intend #chip exits
set syncing false
rest
expect still #clock
