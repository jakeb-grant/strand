id     = "bug24-flip-open-late1"
about  = """bug24-flip-open with the text one frame late: `text late 1 via waker`
is a text worker slower than the frame's waits (NEW_TEXT_WAIT and ESTIMATE_WAIT,
crates/strand-render/src/renderer/mod.rs: a font's first load), answering after
the frame that asked, then the runtime's text_ready (Renderer::update) before the
next frame. That frame is laid out by the text's estimate (ten lines in its
14 px), so the bars' layout drops 9 px for one frame; they start gliding there
and turn back when the shaped text arrives, from where they were drawn. Their
motion follows the layouts drawn (envelope) and settles; they leave their level
by up to 3 px, which `expect still #bars y` records as a known failure.

Not a mutant proof: under eval/mutants/bug24-flip-open.patch the bars go to y 6
on the frame the text arrives (the glide carried across the new layout), inside
the envelope of the layouts drawn (9 to 18, give 3.15). bug24-flip-open is the
proof (docs/decisions.md eval-sandbox)."""
expect_fail = { expect = "a text later than the frame's waits is laid out by its estimate for a frame (renderer/mod.rs ESTIMATE_WAIT accepts it), and the bars dip up to 3 px off their level and back: the owner's call (eval-sandbox finding)" }
screen = { width = 300, scale = 1.0 }
hz     = 60

=== shell.strand
state dnd = false
bar Top {
  height: 30
  split { width: 300; height: 30; pad: 0, 14
    end { align: center
      row { gap: 6; align: center; shrink: 0
        box { id: bars; enter { opacity: 0; scale: 0.6 }
          row { gap: 2; height: 12; align: end
            for i in [0, 1, 2] key i { box { width: 4; height: 8 + i * 2; bg: #00ff00 } }
          }
        }
        if dnd { text "iiii" { id: focus; width: 14; shrink: 0; color: #ff00ff } }
      }
    }
  }
}

=== steps
rest                     # boot: the bars enter
text late 1 where "iiii" via waker
mark flip-open
set dnd true
rest max 120
expect still #bars y
expect moves #bars x
expect visible #focus
