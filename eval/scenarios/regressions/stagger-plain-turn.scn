id     = "stagger-plain-turn"
about  = """A finding of the stagger review (docs/decisions.md stagger): a stagger
numbers only the children with an `enter`, mounting into a surface already
shown as on a surface's first frame. Into a bar already shown, a row with
`stagger: 40ms` mounts a plain box, three keyed rows with an `enter`, a plain
row holding an entering box (its own parent has no stagger), and a box whose
`enter` is the `popin(0.8)` preset; then, with a `mark` cutting the batch
while its last children still wait, a later batch of a plain box and one with
an `enter`. The plain children are drawn at rest at once and take no turn:
the keyed rows start at 0, 40 and 80 ms, the preset at 120 ms, and the later
batch's box at once. eval/mutants/stagger-plain-turn.patch numbers every
child entering again, so each of them starts one or two turns late."""
screen = { width = 400, scale = 1.0 }
hz     = 60

=== shell.strand
state more = false
state late = false
bar Top {
  height: 30
  row { id: list; width: 400; height: 30; gap: 6; align: center; pad: 0, 10; stagger: 40ms
    box { id: head; width: 20; height: 12; bg: #00ff00 }
    if more {
      box { id: plain; width: 10; height: 10; bg: #888888 }
      for n in ["one", "two", "three"] key n {
        row { gap: 3; align: center; enter { opacity: 0; y: 6 }
          box { width: 8; height: 8; bg: #ff0000 }
          text n { color: #ffffff }
        }
      }
      row { id: nest; gap: 2
        box { id: inner; width: 8; height: 8; bg: #0000ff; enter { opacity: 0 } }
      }
      box { id: preset; width: 10; height: 10; bg: #ffff00; enter: popin(0.8) }
    }
    if late {
      box { id: plainlate; width: 6; height: 6; bg: #444444 }
      box { id: latebox; width: 10; height: 10; bg: #ff00ff; enter { opacity: 0; x: 8 } }
    }
  }
}

=== steps
rest
mark more
set more true
frames 3
mark late
set late true
rest
expect visible text("three")
