id     = "title-pill-cut"
about  = """owner-testing.md bug 13 (crates/strand-render/tests/morph.rs TITLE, with
ids): the window pill, a title cut with `ellipsis: end` in a row whose width
springs, room after it. The title stays visible and inside its box on every
frame as the pill grows, shrinks and grows again; the room box moves with the
spring (authored), never past it."""
screen = { width = 800, scale = 1.0 }

=== shell.strand
state grown = false
bar Top {
  height: 30
  box { width: 100; height: 30
    popup { id: big; open: true; width: 420; height: 40; margin: 0
      row { id: pill; bg: #202020; clip: true; height: 40; align: center
            width: grown ? 400 : 90 ~ spring(320, 0.62)
        text "Firefox: a window title much too long for the pill it is in" {
          id: title; shrink: 1; min_width: 0; ellipsis: end; color: #ffffff }
        box { id: room; width: 30; height: 20; shrink: 0 }
      }
    }
  }
}

=== steps
rest
expect visible #title
mark grow
set grown true
rest
expect visible #title
mark shrink
set grown false
rest
expect visible #title
mark regrow
set grown true
rest
expect visible #title
