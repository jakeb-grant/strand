id     = "bug24-flip-open-late1"
about  = """bug24-flip-open with the text one frame late: `text late 1 via waker`
is a text worker slower than the frame's waits (NEW_TEXT_WAIT and ESTIMATE_WAIT,
crates/strand-render/src/renderer/mod.rs: a font's first load), answering after
the frame that asked, then the runtime's text_ready (Renderer::update) before the
next frame. That frame is laid out with the text taking no room of its own
(docs/decisions.md late-text-dip): its fixed 14 px width, no height. The bars
glide left once from the frame that mounts it, on their level, and the glyph
appears where it is shaped. Before late-text-dip the frame was laid out by the
text's estimate (lines wrapped in its 14 px): the bars' layout dropped 9 px for
that frame and they dipped up to 3 px off their level and back
(crates/strand-render/src/renderer/tests.rs::a_late_text_moves_its_siblings_once)."""
screen = { width = 300, scale = 1.0 }
hz     = 60

=== shell.strand
state dnd = false
bar Top {
  height: 30
  split { width: 300; height: 30; pad: 0, 14
    end { align: center
      row { gap: 6; align: center; shrink: 0
        box { id: bars; enter { opacity: 0; scale: 0.6 }
          row { gap: 2; height: 12; align: end
            for i in [0, 1, 2] key i { box { width: 4; height: 8 + i * 2; bg: #00ff00 } }
          }
        }
        if dnd { text "iiii" { id: focus; width: 14; shrink: 0; color: #ff00ff } }
      }
    }
  }
}

=== steps
rest                     # boot: the bars enter
text late 1 where "iiii" via waker
mark flip-open
set dnd true
rest max 120
expect still #bars y
expect moves #bars x
expect visible #focus
