---
source: crates/strand-compiler/tests/instantiate.rs
expression: shell.scene.render_tokens()
---
accent = #455e91
accent_container = #d8e2ff
bg = #faf9ff
error = #ba1a1a
error_container = #ffdad6
fg = #1a1b20
fg_variant = #44474f
font.caption = "Inter" 11px 400
font.mono = "JetBrains Mono" 12px 400
font.title = "Inter" 18px 600
font.ui = "Inter" 13px 500
inverse_accent = #aec6ff
inverse_fg = #f1f0f7
inverse_surface = #2f3036
motion.bouncy = Spring { stiffness: 380.0, damping: 0.75 }
motion.effects = Spring { stiffness: 1600.0, damping: 1.0 }
motion.spatial = Spring { stiffness: 700.0, damping: 0.9 }
on_accent = #ffffff
on_accent_container = #2c4678
on_bg = #1a1b20
on_error = #ffffff
on_error_container = #93000a
on_secondary = #ffffff
on_secondary_container = #3f4759
on_tertiary = #ffffff
on_tertiary_container = #583e5a
outline = #757780
outline_variant = #c5c6d0
radius.full = 999
radius.lg = 14
radius.md = 10
radius.sm = 6
radius.xl = 20
scrim = #000000
secondary = #575e71
secondary_container = #dbe2f9
shadow = #000000
space.1 = 4
space.2 = 8
space.3 = 12
space.4 = 16
surface = #faf9ff
surface_bright = #faf9ff
surface_container = #eeedf4
surface_dim = #dad9e0
surface_high = #e8e7ef
surface_highest = #e2e2e9
surface_low = #f3f3fa
surface_lowest = #ffffff
surface_tint = #455e91
surface_variant = #e1e2ec
tertiary = #715573
tertiary_container = #fcd7fb
accent.container := $accent.alpha(0.22)
accent.hover := $accent.mix($on_accent, 0.08)
border := oklch(from $surface, l: (l + 0.12))
elevation.lg := template(0 8 24 0 #000000, 0 1 2 0 #000000 <- $shadow.alpha(0.3), $shadow.alpha(0.2))
elevation.md := template(0 2 8 0 #000000 <- $shadow.alpha(0.25))
elevation.xl := template(0 16 48 0 #000000 <- $shadow.alpha(0.4))
fg.faint := $fg.alpha(0.35)
fg.muted := $fg.alpha(0.65)
surface.hi := $surface.mix($fg, 0.08)
