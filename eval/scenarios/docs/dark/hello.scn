# Generated by scripts/site/media.sh from ../hello.scn: the same scenario with the
# system in dark mode, for the site's dark pictures. Do not edit.
id     = "docs-hello-dark"
about  = """The site's front page (site/index.md): design.md's hello bar, word
for word, on a 640 px screen at scale 2 (the width of its place beside the copy) with the mock's services."""
screen = { width = 640, height = 360, scale = 2.0 }

[services]
"system.dark" = true
"system.accent" = "#a13c1c"
"battery.percent" = 0.82
"windows.focused" = '{"id": "1", "title": "README.md — Strand", "app_id": "editor", "icon": "", "workspace": 1, "focused": true, "minimized": false, "maximized": false, "fullscreen": false, "urgent": false, "app": null, "rect": null}'

=== shell.strand
bar Top {
  edge: top; height: 32
  split {
    start  { text windows.focused?.title ?? "" }
    center { text clock.format("%H:%M") }
    end    { text pct(battery.percent) }
  }
}

=== steps
rest
