id     = "offset-out-and-back"
about  = """An offset sprung out and called back within one segment travels its whole
excursion (docs/decisions.md evalfix, replay-owner): a sheet whose `y:` springs
down 400 px is called back by logic's own `after` timer 120 ms in, most of the
way down, and springs home. It starts and rests at the same place, and `y:` is
a paint offset, so no frame lays it out elsewhere; a rule that took a
segment's travel from its first and last frames alone gave its 60 to 70 px
steps a bound of one tick's, and called them jumps. design.md "Springs
everywhere" makes an offset a spring between where it is and where it is
written to go, so both ends are on its way, and the pin it carries travels
the same way. Written for Strand's own gate, apart from any shell's values."""
screen = { width = 240, height = 600, scale = 1.0 }
hz     = 60

=== shell.strand
state down = false
on change down after 120ms { if down { down = false } }

panel Drop {
  anchor: top_left; open: true; width: 200; height: 560; bg: #11111b
  col { pad: 12
    box { id: sheet; width: 120; height: 48; radius: 12; bg: #3b4252
          y: 0 ~ spring(900, 1)
          when down { y: 400 ~ spring(900, 1) }
      box { id: pin; width: 10; height: 10; radius: full; bg: #88c0d0; margin: 8 }
    }
  }
}

=== steps
rest
mark out-and-back
set down true
rest
