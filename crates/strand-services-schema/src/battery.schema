/// A power source UPower reports besides the combined battery: a
/// laptop's own batteries, a mouse's, a headset's. Keyed by `id`.
record PowerDevice key id {
  /// Its UPower object path.
  id: text
  /// Its model name, or its kernel name when it has none.
  name: text
  /// What it is: `battery`, `ups`, `mouse`, `keyboard`, `headset`,
  /// `phone`, `tablet`, `gaming_input` or `other`.
  kind: text
  /// Charge, 0 to 1.
  percent: float
  /// It is charging.
  charging: bool
  /// An icon name for its charge and state.
  icon: text
}

/// The battery, from UPower: its combined display device, followed live,
/// and every power source it reports.
service battery {
  /// A battery is present: `if battery.present { Battery }`.
  present: bool
  /// Charge, 0 to 1: `pct(battery.percent)`.
  percent: float
  /// It is charging.
  charging: bool
  /// Time until empty, or until full while charging; null when unknown.
  time_left: duration?
  /// An icon name for its charge and state.
  icon: text
  /// Power draw in watts.
  power: float
  /// Every power source but line power, keyed by `id`: laptop batteries
  /// and the batteries of peripherals.
  devices: [PowerDevice]
  /// The battery's charge over the last `span`, as UPower recorded it
  /// (`GetHistory`, which UPower keeps across reboots): `points` charges,
  /// 0 to 1, evenly spaced from `span` ago to now, oldest first, so a
  /// chart shows the hours before the shell started: `let past =
  /// battery.history(10800s) ?? []`. Each is the charge last recorded at
  /// or before its time; the times before UPower's first record in the
  /// span are left out, so the list may be shorter (it still ends now).
  /// Of the laptop's first battery that keeps a history; an error when
  /// none does. Asked only when called, never polled. `points` is at
  /// most 2000.
  fn history(span: duration, points: int = 60) -> Async<[float]>
}
