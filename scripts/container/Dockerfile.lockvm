# The lock screen's VM tier (design.md, "Testing": a real PAM stack and
# a real session lock). Built and run by scripts/container/lockvm.sh.
#
# Two stages. `guest` is the VM's root filesystem: Ubuntu 24.04 (the
# check image's release, so binaries run.sh builds run in it) with the
# kernel, headless sway, grim, the strand binary's runtime libraries,
# pamtester, a baked test user and /etc/pam.d/strand, (services-round)
# polkitd with its setuid polkit-agent-helper-1 and greetd (the polkit
# and greetd scenarios; they bring systemd's files, but PID 1 stays
# lockvm-init, and neither starts on its own), and lockvm-init as PID 1. `disk` turns that tree into an ext4 image (mke2fs -d: no loop
# mount, no root on the host) and takes out the guest's kernel, made
# readable by any uid. The final stage is QEMU plus those two files. The guest boots the image
# with snapshot=on: every run starts from the same disk.
#
# (lockmon) A stage before them builds polkit 127 from its release
# tarball (sha256-pinned) into /opt/polkit127, which the guest gets
# beside Ubuntu's own polkit 124: polkit.sh runs once with each, 124's
# setuid helper and 127's socket-activated one
# (/run/polkit/agent-helper.socket), so both ways Strand's agent reaches
# a helper run for real. The helper there is installed without setuid,
# as polkit 127's packages ship it for the socket only. The guest names
# 127's runtime libraries (duktape) and systemd-socket-activate (systemd)
# itself, though polkitd pulls both in today.
FROM ubuntu:24.04 AS polkit127
ENV DEBIAN_FRONTEND=noninteractive
ARG POLKIT_VERSION=127
ARG POLKIT_SHA256=9b7bc16f086479dcc626c575976568ba4a85d34297a750d8ab3d2e57f6d8b988
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl python3-pip ninja-build gcc \
      pkg-config perl gettext libglib2.0-dev libexpat1-dev libpam0g-dev \
      duktape-dev libsystemd-dev \
 && rm -rf /var/lib/apt/lists/*
# polkit 127 needs meson 1.4 or later; Ubuntu 24.04 has 1.3.2.
RUN pip3 install --no-cache-dir --break-system-packages meson==1.4.2
RUN curl -fsSL -o /tmp/polkit.tar.gz \
      "https://github.com/polkit-org/polkit/archive/refs/tags/${POLKIT_VERSION}.tar.gz" \
 && echo "${POLKIT_SHA256}  /tmp/polkit.tar.gz" | sha256sum -c - \
 && tar xzf /tmp/polkit.tar.gz -C /tmp \
 && cd "/tmp/polkit-${POLKIT_VERSION}" \
 && meson setup build --prefix=/opt/polkit127 --libdir=lib \
      -Dc_link_args=-Wl,-rpath,/opt/polkit127/lib \
      -Dsession_tracking=logind -Dsystemdsystemunitdir=/opt/polkit127/lib/systemd/system \
      -Dprivileged_group=sudo -Dos_type=debian -Dauthfw=pam \
      -Dpam_prefix=/opt/polkit127/etc/pam.d -Dintrospection=false -Dman=false \
      -Dtests=false -Dexamples=false -Dgtk_doc=false -Dgettext=false \
 && meson compile -C build \
 && DESTDIR=/stage meson install -C build \
 && chmod 0755 /stage/opt/polkit127/lib/polkit-1/polkit-agent-helper-1 /stage/opt/polkit127/bin/pkexec \
 && ls -l /stage/opt/polkit127/lib/polkit-1 /stage/opt/polkit127/share/polkit-1/rules.d

FROM ubuntu:24.04 AS guest
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends linux-image-virtual kmod \
      sway grim dbus fonts-dejavu-core adwaita-icon-theme \
      libfontconfig1 libxkbcommon0 libwayland-client0 libpipewire-0.3-0t64 libvulkan1 \
      libpam-modules libpam-runtime pamtester passwd \
      polkitd greetd \
      libduktape207 systemd \
 && (dpkg --remove --force-depends fonts-dejavu fonts-dejavu-extra || true) \
 && rm -rf /var/lib/apt/lists/* /var/cache/apt/*
# The test user: uid 1000, password "strand-test" (lockvm.sh, the lock
# tests). /etc/pam.d/strand is Ubuntu's usual stack; a scenario can
# replace it, since the guest's writes never reach the image.
RUN (userdel -r ubuntu 2>/dev/null || true) \
 && useradd -m -u 1000 -s /bin/bash tester \
 && echo 'tester:strand-test' | chpasswd \
 && printf '%s\n' '# strand lock screen (scripts/container/Dockerfile.lockvm)' \
      '@include common-auth' '@include common-account' >/etc/pam.d/strand \
 && echo lockvm >/etc/hostname \
 && ls -l /usr/sbin/unix_chkpwd
COPY lockvm/init /sbin/lockvm-init
RUN chmod 0755 /sbin/lockvm-init
COPY --from=polkit127 /stage/opt/polkit127 /opt/polkit127
RUN /opt/polkit127/lib/polkit-1/polkitd --help >/dev/null \
 && command -v systemd-socket-activate

# The disk image, in a stage of its own so the copied tree is not a
# layer of the final image.
FROM ubuntu:24.04 AS disk
COPY --from=guest / /guestroot
# The kernel (Ubuntu's is 0600 root; lockvm.sh runs QEMU as the host
# user) and the root filesystem image, sized to its contents plus room
# for the guest's writes (those go to QEMU's snapshot file anyway).
RUN mkdir -p /lockvm \
 && cp "$(ls /guestroot/boot/vmlinuz-* | sort -V | tail -1)" /lockvm/vmlinuz \
 && chmod 0644 /lockvm/vmlinuz \
 && rm -rf /guestroot/boot/* /guestroot/proc/* /guestroot/sys/* /guestroot/dev/* \
 && size=$(( $(du -sm /guestroot | cut -f1) * 13 / 10 + 256 )) \
 && mke2fs -q -t ext4 -L lockvm-root -d /guestroot /lockvm/rootfs.img "${size}M" \
 && chmod 0444 /lockvm/rootfs.img \
 && ls -l /lockvm

FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends qemu-system-x86 \
 && rm -rf /var/lib/apt/lists/*
COPY --from=disk /lockvm /lockvm
COPY lockvm/run-guest /usr/local/bin/lockvm-run-guest
RUN chmod 0755 /usr/local/bin/lockvm-run-guest
ENV LANG=C.UTF-8
