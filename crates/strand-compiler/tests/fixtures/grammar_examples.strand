// Examples from docs/grammar.md that design.md does not spell out, with
// the declarations they read. The raw colour in the shadow below is the
// one intended lint (`check::raw_color`).

type Pin { app: AppId; label: text }
type Item { name: text; visible: bool; hidden: bool }
type Inner { c: text }
type Outer { b: Inner? }
enum Net { wifi, wired }
state pins: [Pin] key app = []
state secret = ""
state items: [Item] = []
state xs: [Item] = []
state a = Outer(b: null)
state d: text? = null
state cond = true
state visible = true
state ticks = 0

fn clamp01(x: float) -> float { x < 0 ? 0 : x > 1 ? 1 : x }

fn label(n: int) -> text {
  let s = n == 1 ? "item" : "items"
  join(" ", n, s)
}

service temp from poll ["sensors", "-j"] every 5s { cpu: float = package }
service ups from dbus system "org.freedesktop.UPower" "/org/freedesktop/UPower/devices/DisplayDevice" {
  percent: float = Percentage
  permit exec
}
service mood from file "~/.cache/mood.json" { level: int = level }
service music from listen ["playerctl", "-F", "metadata"] { title: text? = title }
permit exec "sensors", "playerctl"

keyframes shake { 0%, 100% { x: 0 }; 25% { x: -4 }; 75% { x: 4 }; duration: 300ms }

export let total = pins.len
enum Side { left, right
  top
  bottom,
}

lock {
  input { type: password; text: <-> secret; on activate { auth.submit(secret) } }
}

component Grammar(level: float, side: Side = left) {
  state page = wifi
  state cur = level
  state dir = side
  let lines = [
    "a",
    "b",
  ]
  text clock.today.month_start().add(months: -1).format("%B")
  box { shadow: 0 (-2px) 8px $shadow.alpha(0.2), 0 1px 2px #00000040 }
  box { margin: 8, 8, 0 ~ instant }
  box { bg: oklch(from $accent, l: l + 0.12, c: c * 0.5) }
  text match side { left => "L", right => "R", _ => "?" }
  match side {
    left => text "left"
    right => { icon "go-next" }
    _ => box {}
  }
  if level > 0.5 {
    text "high"
  } else if level > 0.2 {
    text "mid"
  }
  else {
    text "low"
  }
  for p in pins key p.app { text p.label }
  box {
    on click {
      let next = cur + 0.1
      if next > 1 { cur = 1 } else { cur = next }
      match dir { left => dir = right, _ => dir = left }
      for p in pins { pins.remove_key(p.app) }
      await sleep(200ms)
    }
    on key(k) { propagate() }
  }
  text items
    .filter(i => i.visible && !i.hidden)
    .map((i: Item) => i.name)
    .join(", ")
  text a.b?.c ?? (d ?? "none")
  text cond
    ? "yes"
    : "no"
  every 1s while visible
  {
    ticks += 1
  }
  canvas { draw: (c) => {
    c.fill($accent)
    c.line(0, 0, c.width, c.height)
  } }
  text xs[0].name
}
