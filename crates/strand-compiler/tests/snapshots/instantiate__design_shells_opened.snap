panel anchor=center layer=overlay keyboard=exclusive screens=focused open=true name="Launcher" enter={opacity: 0; scale: 0.96} exit={opacity: 0; scale: 0.96}
  col width=600 pad=$space.3 gap=$space.2 bg=$surface.alpha(0.82) radius=$radius.xl shadow=$elevation.xl blur=32 clip=true
    input text="" font=$font.title placeholder="Search apps" focus=true nav=node 53
    list max_height=420
      row pad=$space.2 gap=$space.3 align=center radius=$radius.md
        image size=32 source="firefox"
        col grow=1
          text text="Firefox" weight=600 marks=[] mark_color=$accent
          text color=$fg.muted text="" font=$font.caption ellipsis=end
      row pad=$space.2 gap=$space.3 align=center radius=$radius.md
        image size=32 source="foot"
        col grow=1
          text text="Foot" weight=600 marks=[] mark_color=$accent
          text color=$fg.muted text="" font=$font.caption ellipsis=end
      row pad=$space.2 gap=$space.3 align=center radius=$radius.md
        image size=32 source="files"
        col grow=1
          text text="Files" weight=600 marks=[] mark_color=$accent
          text color=$fg.muted text="" font=$font.caption ellipsis=end
panel margin=$space.3 anchor=top_right layer=overlay keyboard=none screens=focused open=true name="Toasts"
  col width=380 gap=$space.2
    col pad=$space.3 gap=$space.2 bg=$surface.alpha(0.88) radius=$radius.lg border=template(1, #000000 <- $border) shadow=$elevation.lg blur=24 enter={x: 420; opacity: 0} exit={x: 420; opacity: 0; height: 0}
      row gap=$space.2
        image size=36 radius=$radius.sm source=""
        col grow=1
          text text="Mail · New message" weight=600 ellipsis=end
          text color=$fg.muted text="…" max_lines=4 markup=basic
        icon size=14 source="window-close-symbolic"
    col pad=$space.3 gap=$space.2 bg=$surface.alpha(0.88) radius=$radius.lg border=template(1, #000000 <- $error) shadow=$elevation.lg blur=24 enter={x: 420; opacity: 0} exit={x: 420; opacity: 0; height: 0}
      row gap=$space.2
        image size=36 radius=$radius.sm source=""
        col grow=1
          text text="Battery · Battery low" weight=600 ellipsis=end
          text color=$fg.muted text="…" max_lines=4 markup=basic
        icon size=14 source="window-close-symbolic"
osd margin=[0, 0, 96] anchor=bottom open=true name="Level" enter={opacity: 0; scale: 0.9} exit={opacity: 0; scale: 0.9}
  row width=260 pad=$space.3 gap=$space.3 align=center bg=$surface.alpha(0.8) radius=full shadow=$elevation.lg blur=24
    icon size=20 source="audio-volume-medium-symbolic"
    meter height=6 grow=1 color=$accent track=$fg.alpha(0.15) value=0.6
    text width=4ch align=end text="60%" font=$font.mono
