id     = "docs-guide-4-launcher"
about  = """Guide level 4's app launcher (docs/guide/level-4.md), word for
word. Toggled open, it shows every app; one letter narrows the list to the
apps whose names hold it, the matched letter in the accent colour. The apps are set on the mock, each with an
icon Adwaita has, and the list holds more than fit in its 420 px, so the
panel keeps one size whatever the query (the site's frame strip needs
every frame the same size)."""
screen = { width = 680, height = 560, scale = 1.0 }

[services]
"system.accent" = "#a13c1c"
"apps.all" = '[{"id": "files", "name": "Files", "comment": "Browse and open your files", "icon": "folder", "categories": [], "actions": []}, {"id": "music", "name": "Music", "comment": "Play your music", "icon": "audio-x-generic", "categories": [], "actions": []}, {"id": "editor", "name": "Text Editor", "comment": "Edit plain text files", "icon": "text-x-generic", "categories": [], "actions": []}, {"id": "photos", "name": "Photos", "comment": "View and organise pictures", "icon": "image-x-generic", "categories": [], "actions": []}, {"id": "videos", "name": "Videos", "comment": "Watch films and clips", "icon": "video-x-generic", "categories": [], "actions": []}, {"id": "viewer", "name": "Document Viewer", "comment": "Read PDFs and documents", "icon": "x-office-document", "categories": [], "actions": []}, {"id": "sheets", "name": "Spreadsheets", "comment": "Tables, sums and charts", "icon": "x-office-spreadsheet", "categories": [], "actions": []}, {"id": "slides", "name": "Presentations", "comment": "Make and show slides", "icon": "x-office-presentation", "categories": [], "actions": []}, {"id": "contacts", "name": "Contacts", "comment": "Your address book", "icon": "x-office-addressbook", "categories": [], "actions": []}, {"id": "games", "name": "Games", "comment": "Play a game", "icon": "input-gaming", "categories": [], "actions": []}, {"id": "printers", "name": "Printers", "comment": "Set up printers", "icon": "printer", "categories": [], "actions": []}, {"id": "webcam", "name": "Webcam", "comment": "Take pictures and video", "icon": "camera-web", "categories": [], "actions": []}, {"id": "trash", "name": "Trash", "comment": "Files you deleted", "icon": "user-trash", "categories": [], "actions": []}, {"id": "home", "name": "Home Folder", "comment": "Open your home folder", "icon": "user-home", "categories": [], "actions": []}, {"id": "remote", "name": "Remote Desktop", "comment": "Connect to another computer", "icon": "folder-remote", "categories": [], "actions": []}, {"id": "settings", "name": "Settings", "comment": "Change how your computer works", "icon": "computer", "categories": [], "actions": []}]'

=== launcher.strand
// launcher.strand. Bind a key to: strand toggle launcher.open
export state open = false
state query = ""
let hits = apps.search(query)          // Async<[Hit]>: fuzzy + frecency, keeps last result

panel Launcher {
  screens: focused; layer: overlay; anchor: center; keyboard: exclusive
  open: <-> open                       // Escape, click-away and focus loss write false
  enter { opacity: 0; scale: 0.96 }    // animated by the compositor, no repaint
  on show { query = "" }
  col { width: 600; pad: $space.3; gap: $space.2; radius: $radius.xl; clip: true
        bg: $surface.alpha(0.82); blur: 32; shadow: $elevation.xl
    input { text: <-> query; placeholder: "Search apps"; font: $font.title; focus: true; nav: results }
    list { id: results; max_height: 420               // virtualised; arrows move selection
      for h in hits {
        row { pad: $space.2; gap: $space.3; radius: $radius.md; align: center
          when hover    { bg: $surface.hi }
          when selected { bg: $accent.container }
          on activate { h.app.launch(); open = false }
          image h.app.icon { size: 32 }
          col { grow: 1
            text h.app.name { marks: h.ranges; mark_color: $accent; weight: 600 }
            text h.app.comment ?? "" { font: $font.caption; color: $fg.muted; ellipsis: end }
          }
        }
      }
    }
    if hits.len == 0 && query != "" && !hits.pending { text "No matches" { color: $fg.muted } }
  }
}

=== steps
rest
mark open
set open true
rest
mark type
set query e
rest
