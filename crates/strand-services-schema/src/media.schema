/// One MPRIS player: an item of `media.players`, with
/// the fields and actions `media` has for the active one.
record Player key id {
  /// Its bus name, such as `org.mpris.MediaPlayer2.spotify`: the key.
  id: text
  /// Its name, such as `Spotify` or `mpv` (its MPRIS `Identity`, else
  /// its bus name's last part).
  name: text
  /// `media.*` follows it now.
  active: bool
  /// It is playing.
  playing: bool
  /// The track's title.
  title: text?
  /// The track's artist.
  artist: text?
  /// The track's album.
  album: text?
  /// The album art, as `media.art` shows it.
  art: text?
  /// Fraction of the track played, 0 to 1. Writable: seeks this player,
  /// as writing `media.position` seeks the active one.
  position: float rw
  /// Time played.
  elapsed: duration
  /// The track's length, when known.
  length: duration?
  /// It can skip to the next track.
  can_next: bool
  /// It can go back to the previous track.
  can_previous: bool
  /// Writing `position` seeks it.
  can_seek: bool
  /// It shuffles. Writable: MPRIS `Shuffle` on this player, as writing
  /// `media.shuffle` sets the active one's.
  shuffle: bool rw
  /// What it repeats. Writable: its MPRIS `LoopStatus`.
  loop: Loop rw
  /// Its own volume, 0 to 1, as its MPRIS `Volume` reports it (above 1
  /// when it amplifies). Writable: a write is held to 0 to 1.
  volume: float rw
  /// Writing `shuffle` changes it.
  can_shuffle: bool
  /// Writing `loop` changes it.
  can_loop: bool
  /// Writing `volume` changes it.
  can_volume: bool
  /// Plays or pauses it.
  action play_pause()
  /// Skips it to the next track.
  action next()
  /// Takes it back to the previous track.
  action previous()
  /// Makes it the player `media.*` follows, until it leaves or another
  /// player starts playing: `on click { p.select() }`.
  action select()
}

/// The active media player, over MPRIS: every `org.mpris.MediaPlayer2.*`
/// on the session bus, the one playing (the latest to start) chosen, else
/// the latest to pause, unless one was picked with `p.select()`, which
/// holds until that player leaves or another starts playing; `players`
/// lists them all. Its position is carried forward from the
/// player's last report at its rate, never asked for again (no polling),
/// and only while a visible reader shows it.
service media {
  /// Something is playing.
  playing: bool
  /// The track's title.
  title: text?
  /// The track's artist.
  artist: text?
  /// The track's album.
  album: text?
  /// The album art: `image media.art { fit: cover }`. Local art (a
  /// `file://` URL or a path) as the player sent it; remote (`https://`,
  /// `http://`) art fetched and shown as a file once it is in. Null when
  /// the player sent none, while remote art loads, or when it failed, so
  /// `media.art ?? "audio-x-generic"` falls back.
  art: text?
  /// Fraction of the track played, 0 to 1. Writable: a scrubber's
  /// `slider { value: <-> media.position }` seeks the player (MPRIS
  /// `SetPosition`, or `Seek` when the track has no id). A player that
  /// cannot seek, or a track of unknown length, keeps its place.
  position: float rw
  /// Time played.
  elapsed: duration
  /// The track's length, when known.
  length: duration?
  /// The active player's name, such as `Firefox` or `mpv`; null when no
  /// player runs.
  player: text?
  /// The active player can skip to the next track (MPRIS `CanGoNext`):
  /// `opacity: media.can_next ? 1 : 0.4`. False when no player runs or
  /// it takes no control (`CanControl` false).
  can_next: bool
  /// The active player can go back to the previous track
  /// (`CanGoPrevious`, as `can_next`).
  can_previous: bool
  /// Writing `position` seeks: the active player can seek (`CanSeek`, as
  /// `can_next`) and the track's length is known.
  can_seek: bool
  /// The active player shuffles: `on click { media.shuffle =
  /// !media.shuffle }`. Writable: MPRIS `Shuffle`. False when no player
  /// runs or it has no shuffle. A write it cannot take (`can_shuffle`
  /// false) leaves the value as it was.
  shuffle: bool rw
  /// What the active player repeats: `media.loop = playlist`. Writable:
  /// MPRIS `LoopStatus`. `none` when no player runs or it has no loop
  /// setting. A write it cannot take (`can_loop` false) leaves the value
  /// as it was.
  loop: Loop rw
  /// The active player's own volume, apart from the system's
  /// (`audio.sink.volume`): `slider { value: <-> media.volume }`. 0 to 1,
  /// as MPRIS `Volume` reports it (above 1 when the player amplifies).
  /// Writable: a write is held to 0 to 1, and one it cannot take
  /// (`can_volume` false) leaves the value as it was. 0 when no player
  /// runs or it has no volume.
  volume: float rw
  /// Writing `shuffle` changes it: the active player has MPRIS `Shuffle`
  /// and takes control (`CanControl` not false). False when no player
  /// runs.
  can_shuffle: bool
  /// Writing `loop` changes it (`LoopStatus`, as `can_shuffle`).
  can_loop: bool
  /// Writing `volume` changes it (`Volume`, as `can_shuffle`).
  can_volume: bool
  /// Every player running, keyed by its bus name (`for p in
  /// media.players key p.id { … }`): a switcher, a card per player. The
  /// one `media.*` follows is `active`; `p.select()` picks another. Read
  /// only while a visible reader reads it; its playing players' times
  /// tick once a second then.
  players: [Player]
  /// Plays or pauses.
  action play_pause()
  /// Skips to the next track.
  action next()
  /// Goes back to the previous track.
  action previous()
}
