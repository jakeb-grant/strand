/// A mounted filesystem, keyed by `path`.
record Filesystem key path {
  /// Where it is mounted: `/`, `/home`.
  path: text
  /// The device it is on: `/dev/nvme0n1p2` (the mount's source).
  device: text
  /// The fraction in use, 0 to 1, as `df` counts it (used over used plus
  /// free).
  usage: float
  /// Bytes in use.
  used: float
  /// Bytes in all.
  total: float
  /// Bytes free to a user (space reserved for root left out).
  free: float
}

/// Disk usage of the mounted filesystems (`statvfs`), read every 10 s
/// while a reader is visible.
service disk {
  /// The root filesystem's fraction in use, 0 to 1: `pct(disk.usage)`.
  usage: float
  /// The root filesystem's bytes in use.
  used: float
  /// The root filesystem's size in bytes.
  total: float
  /// The root filesystem's bytes free to a user.
  free: float
  /// Every mounted filesystem on a local disk, `/` first, keyed by
  /// `path`.
  all: [Filesystem]
}
