/// The lock screen's password check: a PAM helper of its own
/// (`strand-auth`, a separate process) checks each password with the
/// `strand` PAM service, or `login` when `/etc/pam.d/strand` is missing.
/// Only a success unlocks the session lock; anything else leaves it
/// locked.
service auth {
  /// A password is being checked.
  busy: bool
  /// The last password was refused, or could not be checked.
  failed: bool
  /// Checks `password`: `input { type: password; text: <-> secret;
  /// focus: true; on activate { if secret != "" { auth.submit(secret) };
  /// secret = "" } }` (Return in the field activates it; an empty field
  /// is not sent, since with pam_faillock each empty Return pressed to
  /// wake the screen would count as a failed login). Every password,
  /// empty or not, goes to PAM. Ignored while one is being checked.
  action submit(password: text)
}
