/// An audio sink or source, from PipeWire.
record AudioDevice key id {
  /// Its PipeWire id.
  id: int
  /// Its node name.
  name: text
  /// A readable description of it.
  description: text
  /// Volume, 0 to 1, on the cubic scale `wpctl` and `pactl` show (above 1
  /// when another program amplified it). Writable:
  /// `audio.sink.volume -= dy * 0.05`; every channel takes the new value.
  volume: float rw
  /// Muted. Writable: `audio.sink.muted = !audio.sink.muted`.
  muted: bool rw
  /// An icon name for its volume and mute state.
  icon: text
  /// It is the default device.
  default: bool
  /// Makes it the default device.
  action make_default()
}

/// A program's audio stream, from PipeWire: what it
/// plays or records.
record AudioStream key id {
  /// Names it while it lives: PipeWire's `object.serial` for it, which,
  /// unlike its global id, no later stream takes.
  id: int
  /// The program's name, such as `Firefox`.
  app: text
  /// An icon name for the program.
  icon: text
  /// `output` while it plays, `input` while it records a source (a
  /// microphone in use), `monitor` while it records what a sink plays (a
  /// visualiser, a recorder of the desktop's sound): a microphone light is
  /// `audio.streams.any(s => s.direction == input)`.
  direction: StreamDirection
  /// Its own volume, on the scale a device's uses. Writable:
  /// `st.volume = v`.
  volume: float rw
  /// Muted. Writable: `st.muted = !st.muted`.
  muted: bool rw
}

/// A peak meter `audio.levels` runs: an item of
/// `audio.meters`.
record AudioMeter key device {
  /// The device it reads (`AudioDevice.id`).
  device: int
  /// Its latest spectrum: 64 bands from low to high pitch, each 0 to 1;
  /// empty while the device is quiet.
  bands: [float]
}

/// Audio devices and the programs' streams, from PipeWire, and levels for
/// a visualiser of one's own (`audio.levels`).
service audio {
  /// The default output: `audio.sink.volume`, `audio.sink.muted`.
  sink: AudioDevice
  /// The default input.
  source: AudioDevice
  /// Every output, keyed by `id`.
  sinks: [AudioDevice]
  /// Every input, keyed by `id`.
  sources: [AudioDevice]
  /// The programs' streams, keyed by `id`: what plays (a per-app
  /// mixer: `for st in audio.streams.filter(s => s.direction ==
  /// output) key st.id { slider { value: <-> st.volume } }`) and what
  /// records (a microphone indicator: `audio.streams.any(s => s.direction ==
  /// input)`). Followed only while a reader reads it. Peak meters
  /// (pavucontrol's, Strand's own) are left out.
  streams: [AudioStream]
  /// The meters `audio.levels` runs, keyed by `device`: each one's
  /// latest spectrum, 64 bands from low to high pitch, each 0 to 1
  /// (none while its device is quiet). Read through `audio.levels`,
  /// which asks for the meter; reading this field runs none.
  meters: [AudioMeter]
  /// `device`'s sound now, as `bars` levels from low to
  /// high pitch, each 0 to 1 (zeros while it is quiet), for a
  /// visualiser of one's own (`let v = audio.levels(audio.sink, 32)`,
  /// drawn by a `canvas`); `audio.levels(audio.source, 1)[0]` is a
  /// microphone's level. Its meter runs while a reader of `audio` is
  /// visible and something evaluates `levels` for that device; one no
  /// evaluation has asked for within a second stops. `bars` is at most
  /// 512.
  fn levels(device: AudioDevice, bars: int = 16) -> [float]
}
