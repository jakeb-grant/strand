id     = "reveal-enter"
about  = """An enter a moving clip uncovers is judged where it starts (docs/decisions.md
evalfix, replay-owner): a drawer whose width springs open from 50 to 380 px,
clipping what it holds, mounts two tiles that enter from `opacity: 0; scale:
0.6`. The near one is in view from its first frame and is judged there. The
far one plays its pose from the frame it mounts while wholly cut out, and
comes into view only as the drawer's moving edge reaches it, by then most of
the way to rest: the moving edge is how it comes into view, as a scroll's
edge is for a row it carries in. Judged where it first showed, a frame the
clip chose, it read as a pop-in. Written for Strand's own gate, apart from any
shell's values."""
screen = { width = 420, height = 120, scale = 1.0 }
hz     = 60

=== shell.strand
state open = false

panel Drawer {
  anchor: top_left; open: true
  row { id: drawer; clip: true; height: 44; bg: #2e3440; align: center
        width: 50 ~ spring(260, 0.95)
        when open { width: 380 ~ spring(260, 0.95) }
    row { width: 380; height: 44; shrink: 0; pad: 0, 8; gap: 8; align: center
      if open {
        box { id: near; width: 30; height: 24; shrink: 0; bg: #a3be8c; enter { opacity: 0; scale: 0.6 } }
      }
      box { width: 250; height: 24; shrink: 0 }
      if open {
        box { id: far; width: 40; height: 24; shrink: 0; bg: #ebcb8b; enter { opacity: 0; scale: 0.6 } }
      }
    }
  }
}

=== steps
rest
mark open
set open true
rest
