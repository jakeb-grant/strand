id     = "docs-toasts"
about  = """The notification how-to (site/how-to/notifications.md):
design.md's notification stack (example (c)), word for word but one line:
the panel has a fixed height, since the site's frame strip needs every
frame the same size (in a shell the panel follows its cards). A first
notification arrives and its card slides in from the right as the panel
opens; a second arrives under it; then the first is dismissed and slides
out while its height folds, and the second slides up into its place.
The notifications are set on the mock, since the sandbox runs no
notification daemon, and each step waits a second rather than resting, so
no card reaches its six seconds."""
screen = { width = 440, height = 360, scale = 2.0 }

[services]
"system.accent" = "#a13c1c"
"notifications.popups" = '[]'

=== toasts.strand
// toasts.strand
export state dnd = false persist
let shown = notifications.popups.filter(n => !dnd || n.urgency == critical).take(5)

panel Toasts {
  screens: focused; layer: overlay; anchor: top_right; margin: $space.3; keyboard: none
  open: shown.len > 0
  height: 180                                     // fixed here so every frame is one size
  col { width: 380; gap: $space.2
    for n in shown { Toast n }                    // keyed by n.id automatically
  }
}

component Toast(n: Notification) {
  col { pad: $space.3; gap: $space.2; radius: $radius.lg; border: 1, $border
        bg: $surface.alpha(0.88); blur: 24; shadow: $elevation.lg
    enter { x: 420; opacity: 0 }
    exit  { x: 420; opacity: 0; height: 0 }       // siblings slide up to fill the gap
    when hover { bg: $surface.hi }
    when n.urgency == critical { border: 1, $error }
    after n.timeout ?? 6s while !hover && n.urgency != critical { n.expire() }
    on click     { n.activate() }
    on secondary { n.dismiss() }
    row { gap: $space.2
      image n.image ?? n.app.icon { size: 36; radius: $radius.sm }
      col { grow: 1
        text join(" · ", n.app.name, n.summary) { weight: 600; ellipsis: end }
        text n.body { markup: basic; max_lines: 4; color: $fg.muted }
      }
      icon "window-close-symbolic" { size: 14; on click { n.dismiss() } }
    }
    if n.actions.len > 0 {
      row { gap: $space.1
        for a in n.actions { button a.label { grow: 1; on click { a.invoke() } } }
      }
    }
  }
}

=== steps
rest
mark first
set notifications.popups [{"id": 1, "app": {"name": "Mail", "icon": "mail-unread-symbolic"}, "summary": "Ada Lovelace", "body": "Lunch at noon?", "urgency": "normal"}]
wait 1000
mark second
set notifications.popups [{"id": 1, "app": {"name": "Mail", "icon": "mail-unread-symbolic"}, "summary": "Ada Lovelace", "body": "Lunch at noon?", "urgency": "normal"}, {"id": 2, "app": {"name": "Builds", "icon": "emblem-ok-symbolic"}, "summary": "main passed", "body": "All 412 tests passed.", "urgency": "normal"}]
wait 1000
mark dismiss
set notifications.popups [{"id": 2, "app": {"name": "Builds", "icon": "emblem-ok-symbolic"}, "summary": "main passed", "body": "All 412 tests passed.", "urgency": "normal"}]
wait 1000
