id     = "timed-retarget"
about  = """A pill moves right on a 300 ms `ease_out` curve and dims on a 240 ms
one; six frames in it is sent back, and both turn from where they are
with the speed they had, the velocity carried into the new curve fading
out over it (design.md "Retargeting mid-flight keeps velocity, so
interrupted animations never jolt"; architecture.md "Motion": a timed
curve carries it as `v0·t·(1 − t/d)²`), then rest at their start."""
screen = { width = 300, scale = 1.0 }
hz     = 60

=== shell.strand
state right = false
bar Top {
  height: 30
  row { height: 24; gap: 6; align: center; pad: 0, 8
    box { id: cap; width: 12; height: 12; radius: 3; bg: #e06c75 }
    box { id: pill; width: 40; height: 12; radius: full; bg: #3a7bd5
          x: right ? 180 : 0 ~ ease(ease_out, 300ms)
          opacity: right ? 0.4 : 1 ~ 240ms }
  }
}

=== steps
rest
mark out
set right true
intend #pill moves
frames 6
mark back
set right false
intend #pill moves
rest
mark settled
frames 10
expect still #pill
expect still #cap
