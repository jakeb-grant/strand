id     = "docs-swap"
about  = """The theming page (site/concepts/theming.md): a small bar on
`import("catppuccin:latte")` switched to `import("catppuccin:mocha")` and
back by writing `look`. Every colour moves to the new palette together:
the surface, the text, the accent dot and the derived `$fg.muted`. Its
config is the one the page shows beside its frames."""
screen = { width = 360, height = 120, scale = 2.0 }

=== swap.strand
enum Look { latte, mocha }
state look = latte
use palette match look { latte => import("catppuccin:latte"), mocha => import("catppuccin:mocha") }

bar Top {
  height: 40
  bg: $surface; font: $font.ui; color: $fg
  row { pad: 0, $space.3; gap: $space.2; align: center
    box { size: 12; radius: full; bg: $accent }
    text "Strand"
    spacer {}
    text "12:00" { color: $fg.muted }
  }
}

=== steps
rest
mark mocha
set look mocha
rest
mark latte
set look latte
rest
