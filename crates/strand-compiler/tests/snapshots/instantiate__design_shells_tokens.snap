---
source: crates/strand-compiler/tests/instantiate.rs
expression: shell.scene.render_tokens()
---
accent = #264387
accent_container = #d0defb
bg = #f8f8f9
error = #870f18
error_container = #fcd3cf
fg = #030304
fg_variant = #2b2e34
font.caption = "Inter" 11px 400
font.mono = "JetBrains Mono" 12px 400
font.title = "Inter" 18px 600
font.ui = "Inter" 13px 500
inverse_accent = #a3bef4
inverse_fg = #edeef0
inverse_surface = #151618
motion.bouncy = Spring { stiffness: 380.0, damping: 0.75 }
motion.effects = Spring { stiffness: 1600.0, damping: 1.0 }
motion.spatial = Spring { stiffness: 700.0, damping: 0.9 }
on_accent = #ffffff
on_accent_container = #000117
on_bg = #030304
on_error = #ffffff
on_error_container = #0d0000
on_secondary = #ffffff
on_secondary_container = #020309
on_tertiary = #ffffff
on_tertiary_container = #070108
outline = #5f636d
outline_variant = #babec4
radius.full = 999
radius.lg = 14
radius.md = 10
radius.sm = 6
radius.xl = 20
scrim = #000000
secondary = #3d485d
secondary_container = #d7deec
shadow = #000000
space.1 = 4
space.2 = 8
space.3 = 12
space.4 = 16
surface = #f8f8f9
surface_bright = #f8f8f9
surface_container = #eaebed
surface_dim = #d3d4d7
surface_high = #e3e4e7
surface_highest = #dddee0
surface_low = #f1f2f3
surface_lowest = #ffffff
surface_tint = #264387
surface_variant = #dbdee3
tertiary = #583c5a
tertiary_container = #e8d8e9
accent.container := $accent.alpha(0.22)
accent.hover := $accent.mix($on_accent, 0.08)
border := oklch(from $surface, l: (l + 0.12))
elevation.lg := template(0 8 24 0 #000000, 0 1 2 0 #000000 <- $shadow.alpha(0.3), $shadow.alpha(0.2))
elevation.md := template(0 2 8 0 #000000 <- $shadow.alpha(0.25))
elevation.xl := template(0 16 48 0 #000000 <- $shadow.alpha(0.4))
fg.faint := $fg.alpha(0.35)
fg.muted := $fg.alpha(0.65)
surface.hi := $surface.mix($fg, 0.08)
