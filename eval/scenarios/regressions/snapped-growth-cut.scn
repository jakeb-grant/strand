id     = "snapped-growth-cut"
about  = """A finding of round 4 (docs/decisions.md held-glides), kept for growth: a
centred launcher sized by its content on both axes filters its results
while the query is typed a letter at a time, faster than its motion
settles, then erased: rows that stay glide, rows that leave fade out,
rows that come back fade in, and the card's width follows its longest
result. When the content snaps larger (rows come back with a fade only),
the compositor re-centres the larger buffer and the card's box springs
from the size it was drawn at to its new one about its centre, each
letter retargeting it (decisions.md growth): the rows it holds are cut
by its box in flight, never by the buffer's edge (`contain`), and the
prompt centred in it never jumps (`teleport`). Round 4's render glided
the card by half the growth from where its corner was, cut 11 px at the
buffer's far edge for 4 frames; eval/mutants/growth-step-clip.patch lets
a box springing over a step stop clipping what it holds, and the rows
past it are cut by the buffer again."""
screen = { width = 360, height = 640, scale = 1.0 }
hz     = 60

=== shell.strand
state query = ""
let apps = ["calculator", "calendar", "camera", "chess", "clock", "contacts", "cheese"]
let hits = apps.filter(a => a.starts_with(query))

panel Launcher {
  anchor: center; open: true
  col { id: card; pad: 9; gap: 5; radius: 12; bg: #1b1d2b; align: center
    text query == "" ? "type to search" : query { id: prompt; color: #c8cbe0 }
    col { id: results; gap: 3
      for a in hits key a {
        row { pad: 0, 7; height: 27; radius: 6; align: center; bg: #2b2f45
          enter { opacity: 0 }
          exit { opacity: 0 }
          text a { color: #eceef8 }
        }
      }
    }
  }
}

=== steps
rest
mark c
set query c
rest
mark ca-cal-calc
set query ca
wait 50
set query cal
wait 50
set query calc
rest
mark erase
set query cal
wait 40
set query ca
wait 40
set query c
rest
mark clear
set query ""
rest
