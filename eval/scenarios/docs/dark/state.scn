# Generated by scripts/site/media.sh from ../state.scn: the same scenario with the
# system in dark mode, for the site's dark pictures. Do not edit.
id     = "docs-state-dark"
about  = """The state page's volume bar (site/concepts/state.md), word for
word: a click on the percentage flips `open` and the slider appears; the
volume then changes from outside (as `strand set` would), and both the
text and the slider follow it."""
screen = { width = 360, height = 100, scale = 2.0 }

[services]
"system.dark" = true
"system.accent" = "#a13c1c"
"audio.sink.volume" = 0.45
"audio.sink.muted" = false
"audio.sink.icon" = "audio-volume-medium-symbolic"

=== volume.strand
state open = false
let level = audio.sink.muted ? 0 : audio.sink.volume

bar Volume {
  edge: bottom; height: 32
  bg: $surface; font: $font.ui; color: $fg
  row { pad: 0, $space.3; gap: $space.2; align: center
    icon audio.sink.icon { size: 16 }
    text pct(level) { on click { open = !open } }
    if open {
      slider { width: 120; value: <-> audio.sink.volume }
    }
  }
}

=== steps
rest
mark open
click 50,16 on bar
wait 500
mark louder
set audio.sink.volume 0.7
wait 500
