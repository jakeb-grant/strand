id     = "offset-early-callback"
about  = """An offset called back early (docs/decisions.md evalfix review,
replay-owner): the sheet of offset-out-and-back is called back by logic's own
timer 40 ms in, before it is a third of the way down. Retargeting mid-flight
keeps velocity (design.md "Springs everywhere"), so it turns and springs home
from where it is. Its way is its whole written excursion, so `teleport` gives
a snap home shorter than 0.75 of it a pass; a way in flight dropped for one at
rest is `continuity`'s to catch, and this is the case it is listed against."""
screen = { width = 240, height = 600, scale = 1.0 }
hz     = 60

=== shell.strand
state down = false
on change down after 40ms { if down { down = false } }

panel Drop {
  anchor: top_left; open: true; width: 200; height: 560; bg: #11111b
  col { pad: 12
    box { id: sheet; width: 120; height: 48; radius: 12; bg: #3b4252
          y: 0 ~ spring(900, 1)
          when down { y: 400 ~ spring(900, 1) }
      box { id: pin; width: 10; height: 10; radius: full; bg: #88c0d0; margin: 8 }
    }
  }
}

=== steps
rest
mark early-callback
set down true
rest
