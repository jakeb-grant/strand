---
source: crates/strand-compiler/tests/instantiate.rs
expression: shell.scene.render()
---
bar edge=top screens="Mock | DP-1 | Display" name="Top"
panel name="Shows"
panel keyboard=none name="KeyboardNone"
panel keyboard=on_demand name="KeyboardOnDemand"
panel keyboard=exclusive name="KeyboardExclusive"
bar screens="Mock | DP-1 | Display" name="Everything"
  col
    box bg=$accent
    text text="09:41"
    slider two_way=[value] value=0.5
    popup open=false two_way=[open]
    col color=$fg font=$font.ui
    box
    text text="0%"
    box margin=[8, 8, 0]
    list row_count=3 row_first=0
      text text="Firefox"
      text text="Foot"
      text text="Files"
    segmented two_way=[value] value=auto options=[auto, light, dark, wallpaper, mocha]
    col tokens={$surface: $surface.alpha(0.5)}
    box place=absolute
    box gap=0 watch=query
    box hit=grow(6)
    box width=24
    box width=24
    box width=24
    input nav=node 25
    list
    box drag="Pin { app: firefox, label: Firefox }"
    pages current=wifi row_first=3489
      page name=wifi
        text text="Wi-Fi"
    box tooltip="A tooltip"
    shader source="aurora.wgsl"
    canvas
    box radius=[14, 14, 0, 0] corners=squircle
    popup attach=top
    box shape=cookie
    box stroke=template(3, #000000 <- $accent) trim=[0, 0.5] cap=round wave=[2, 18]
    arc width=4 value=0 sweep=270deg
    merge value=10
      box
      box
    box bg=template(linear(45deg, #000000, #000000) <- $accent, $tertiary)
    box bg=template(conic(from 90deg, #000000, #000000) <- $accent, $secondary)
    box border=template(2, conic(from 0deg, #000000, #000000, #000000) <- $accent, $secondary, $accent)
    box glow=[12, $accent.alpha(0.6)]
    box inner_shadow=template(0 2 6 0 #000000 <- $shadow) rim=[top, $fg.alpha(0.15)]
    box grain=0.04
    text fill=template(linear(90deg, #000000, #000000) <- $accent, $tertiary) text="x" text_stroke=template(1, #000000 <- $bg)
    letters y=0
    popup scrim=$shadow.alpha(0.3)
    box filter=grayscale(1)
    box filter=saturate(1.3)
    box filter=hue(30deg)
    box filter=brightness(0.9)
    box filter=tint($accent)
    box blend=screen
    box blend=add
    box blend=multiply
    box blend=overlay
    box blend=difference
    box mask=fade(bottom, 24)
    box mask=radial(center, 40%)
    box mask=shape(cookie)
    box backdrop=blur(16)
    box blur=24
    box blur=24 blur_fallback=tint
    box blur=24 blur_fallback=none
    box x=4
    box x=4
    box enter=popin(0.8) exit=popin(0.8)
    box enter=slide(top) exit=slide(top)
    box enter=slidefade exit=slidefade
    box enter=fade exit=fade
    box x=0 y=0 scale=0
    box
    row stagger=30ms
    box morph="media"
    text text="50%" roll=true
    box jelly=0.4
    box parallax=6 tilt=8deg
    row bg=$surface.alpha(0.7) radius=full corners=squircle border=template(1.5, conic(from 0deg, #000000, #000000, #000000) <- $accent, $tertiary, $accent) blur=24 morph="media"
      image size=28 rotate=0 shape=cookie
      spectrum width=72 color=$accent source="40" bars=24 style=mirror
    box
    col
    col pad=$space.2 bg=$surface radius=$Toast2.radius font=$font.ui
    box size=8
    col
    box
    box
    text text="1"
    text text="2"
    text text="3"
    box size=8
    col
    box
    box
    text text="1"
    text text="2"
    text text="3"
    box size=8
    col
    box
    box
    text text="1"
    text text="2"
    text text="3"
    box
    col
    col pad=$space.2 bg=$surface radius=$Toast2.radius font=$font.ui
    box size=8
    col
    box
    box
    text text="1"
    text text="2"
    text text="3"
    box size=8
    col
    box
    box
    text text="1"
    text text="2"
    text text="3"
    box size=8
    col
    box
    box
    text text="1"
    text text="2"
    text text="3"
    box size=8
    box size=8
    box size=8
    effect style=lightning speed=1
    effect style=sparks speed=1
    effect style=shimmer speed=1
    effect style=ripple speed=1
    effect style=aurora speed=1
    particles glow=6 rate=20 life=1200ms sprite=dot(3)
    spectrum source="40" bars=48 smooth=0.6 style=mirror
    graph fill=$accent.alpha(0.2) value=0 history=60000ms
    meter value=0 wave=0
    image source="spin.gif"
    lottie source="loader.json" speed=1
    svg source="icon.svg"
    image filter=blur(30) fit=cover
    thumbnail source="w1"
