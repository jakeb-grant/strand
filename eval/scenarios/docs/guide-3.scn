id     = "docs-guide-3"
about  = """The guide's level 3 (docs/guide/level-3.md), the whole bar as
the level leaves it, its five files word for word, on a 760 px screen at
scale 2. The pointer rests on the speaker and the volume slider slides
out, then leaves and it slides back; a fourth workspace is made and its
dot grows in."""
screen = { width = 760, height = 120, scale = 2.0 }

[services]
"system.accent" = "#a13c1c"
"windows.focused" = '{"id": "1", "title": "Terminal", "app_id": "terminal", "icon": "", "workspace": 1, "focused": true, "minimized": false, "maximized": false, "fullscreen": false, "urgent": false, "app": null, "rect": null}'
"workspaces.all" = '[{"id": 1, "name": "1", "focused": true, "active": true, "occupied": true, "urgent": false, "screen": "DP-1", "windows": []}, {"id": 2, "name": "2", "focused": false, "active": false, "occupied": true, "urgent": false, "screen": "DP-1", "windows": []}, {"id": 3, "name": "3", "focused": false, "active": false, "occupied": true, "urgent": false, "screen": "DP-1", "windows": []}]'
"tray.items" = '[{"id": "nm", "title": "Network", "icon": "network-wireless-signal-good-symbolic", "status": "Active"}, {"id": "bt", "title": "Bluetooth", "icon": "bluetooth-active-symbolic", "status": "Active"}]'
"battery.present" = true
"battery.percent" = 0.82
"battery.time_left" = "8100s"
"battery.icon" = "battery-level-80-symbolic"
"audio.sink.volume" = 0.6
"audio.sink.muted" = false
"audio.sink.icon" = "audio-volume-medium-symbolic"

=== bar.strand
// bar.strand: one instance per monitor; `screen` is in scope
bar Top {
  edge: top; height: 36; margin: $space.2, $space.2, 0
  bg: $surface.alpha(0.72); blur: 24; radius: $radius.lg; shadow: $elevation.md
  font: $font.ui; color: $fg                      // inherited by every child
  split { pad: 0, $space.3                         // centre is truly centred
    start { gap: $space.3
      row { gap: $space.1
        for ws in workspaces.on(screen) { Dot ws } // keyed by ws.id, no max
      }
      text windows.focused?.title ?? "" { color: $fg.muted; max_width: 40%; ellipsis: end }
    }
    center { Clock }
    end { gap: $space.3
      Volume
      if battery.present { Battery }
      for item in tray.items {
        image item.icon { size: 16
          on click     { item.activate() }
          on secondary { item.menu.open() }
        }
      }
    }
  }
}

=== dot.strand
component Dot(ws: Workspace) {
  box { size: 8; radius: full; bg: $fg.alpha(0.25); hit: grow(6)
    when ws.occupied { bg: $fg.muted }
    when ws.focused  { width: 24; bg: $accent }    // later `when` wins, like CSS
    when ws.urgent   { bg: $error }
    when hover       { bg: $accent.hover }
    when pressed     { scale: 0.9 }
    enter { width: 0; opacity: 0 }                 // exit mirrors enter
    on click { ws.focus() }
  }
}

=== clock.strand
component Clock {
  state open = false                               // one per monitor
  text clock.format("%a %d  %H:%M") {              // wakes once a minute
    on click { open = !open }
    popup { open: <-> open; Calendar }             // anchored here; Esc or click-away closes
  }
}

component Calendar {
  state month = clock.today.month_start()
  col { pad: $space.3; gap: $space.2; bg: $surface; radius: $radius.lg; shadow: $elevation.lg
    row { align: center
      button "‹" { on click { month = month.add(months: -1) } }
      text month.format("%B %Y") { grow: 1; align: center }
      button "›" { on click { month = month.add(months: 1) } }
    }
    grid { columns: 7; gap: $space.1
      for d in calendar.days(month) {
        text d.date.format("%e") { width: 28; height: 28; align: center
          when !d.in_month { color: $fg.faint }
          when d.date == clock.today { bg: $accent; color: $on_accent; radius: full }
        }
      }
    }
  }
}

=== volume.strand
component Volume {
  row { gap: $space.1
    on scroll(dy) { audio.sink.volume -= dy * 0.05 }
    icon audio.sink.icon { on click { audio.sink.muted = !audio.sink.muted } }
    if hover {                                     // the row's hover, latched while dragging
      slider { width: 90; value: <-> audio.sink.volume
               enter { width: 0; opacity: 0 } }
    }
  }
}

=== battery.strand
component Battery {
  row { gap: $space.1
    icon battery.icon
    text join(" · ", pct(battery.percent), dur(battery.time_left))
    when battery.percent < 0.15 && !battery.charging { color: $error }
  }
}

=== steps
rest
mark hover-volume
pointer 545,26
rest
mark leave
leave
rest
mark new-workspace
set workspaces.all [{"id": 1, "name": "1", "focused": true, "active": true, "occupied": true, "urgent": false, "screen": "DP-1", "windows": []}, {"id": 2, "name": "2", "focused": false, "active": false, "occupied": true, "urgent": false, "screen": "DP-1", "windows": []}, {"id": 3, "name": "3", "focused": false, "active": false, "occupied": true, "urgent": false, "screen": "DP-1", "windows": []}, {"id": 4, "name": "4", "focused": false, "active": false, "occupied": true, "urgent": false, "screen": "DP-1", "windows": []}]
rest
