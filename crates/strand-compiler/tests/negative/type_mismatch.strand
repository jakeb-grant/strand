// expect: check::type_mismatch
// Units are types: a duration is not a number, text is not a length.
state shown = true
component C {
  box { height: "tall"; opacity: true
    after 6 while shown { shown = false }
  }
}
// A segmented's value is one of its options.
enum Look { light, dark }
enum Other { x, y }
state other = Other.x
component Seg { segmented { options: Look; value: <-> other } }
// A whole-number literal is an `int` in the message too.
let label: text = 3
