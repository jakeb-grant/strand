// expect: check::read_only
// Service fields are writable only where the service marks them `rw`.
component C {
  box {
    on click { battery.percent = 1 }
    on scroll(dy) { audio.sink.volume -= dy * 0.05 }
  }
}
// A settings record is written field by field.
state prefs from "~/.config/strand/prefs.toml" { accent: color = #7aa2f7; compact: bool = false }
component Reset { box { on click { prefs = prefs } } }
// An `rw` field reached through neither its service, an item of a
// service's keyed list, nor `state` has nothing to write to.
component Copy { box { on click { let p = prefs; p.compact = true } } }
